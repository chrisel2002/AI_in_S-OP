# Copy to .env and fill in your values
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sales_operations_db?appName=Cluster0
PORT=4000
# Path to the cleaned plan data (relative to project root)
DATA_FILE=../outputs/cleaned_sop_tool_data.csv

# UniGPT (OpenAI-compatible) — for natural-language -> rule parsing
UNIGPT_API_KEY=sk-your-unigpt-key
UNIGPT_BASE_URL=https://gpt.uni-muenster.de/v1
UNIGPT_MODEL=mistral-small
USE_LLM=true
